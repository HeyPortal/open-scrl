{
  "name": "open-scrl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source, feature-rich photo grid + Instagram carousel maker (PWA). MIT licensed alternative to SCRL.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bundle:check": "node scripts/check-bundle.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run bundle:check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@zip.js/zip.js": "^2.8.26",
    "gifuct-js": "^2.1.2",
    "heic2any": "^0.0.4",
    "idb": "^8.0.3",
    "immer": "^10.1.3",
    "konva": "10.7.1",
    "lucide-react": "^0.487.0",
    "mp4-muxer": "^5.2.2",
    "nanoid": "^5.1.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  }
}
